# Copy to .env. Never commit real secrets.

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=financial
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/financial

# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# AI — the app runs without a key; AI features report themselves as unavailable
LLM_PROVIDER=null
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Uploads
MAX_UPLOAD_BYTES=10485760
STORAGE_DIR=./var/documents
